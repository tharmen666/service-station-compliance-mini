# Firebase AI Logic (Hybrid On-Device + Cloud Gemini) configuration
# Leave unset to run in Offline Deterministic Fallback mode without errors.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase App Check
# Set to "true" or a registered debug token UUID for local development.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Optional: reCAPTCHA Enterprise site key for production App Check.
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=

